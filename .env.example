# ── Gemini OCR ───────────────────────────────────────────────────────────
# Get a FREE key (no credit card) at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.6-flash

# ── PostgreSQL ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/receipts

# ── JWT Auth ─────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=*

# ── File uploads ─────────────────────────────────────────────────────────
# UPLOAD_DIR=uploads
# MAX_UPLOAD_BYTES=10485760
